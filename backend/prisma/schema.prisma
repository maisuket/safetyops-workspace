datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id         String   @id @default(uuid())
  enrollment String   @unique
  name       String
  active     Boolean  @default(true)
  records    Record[]
  documents  Document[]
  saidas     SaidaRecord[]
  horasExtras HoraExtraRecord[]
  createdAt  DateTime @default(now())
}

model Record {
  id            String   @id @default(uuid())
  type          String   // "trabalho" | "folga" | "falta" | "servico_externo" | "ajuste_horario"
  date          DateTime
  local         String?  // Local de Trabalho (ITAM, DENSO, KLABIN, etc)
  description   String?
  refDate       String?  // Vai armazenar a string gerada pelo frontend com o histórico
  justification String?  // Justificativa (ex: saída antecipada, serviço externo) para folga/falta
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    String
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@index([date])
  @@index([type])
}

model SaidaRecord {
  id             String    @id @default(uuid())
  tipo           String    // "saida" | "uber"
  tipoData       String?   // "saida" | "entrada" — só quando tipo = "saida"
  destino        String?   // só quando tipo = "uber"
  motivo         String
  dataOcorrencia DateTime? // pode ser null: recurso de "emitir com data em branco"
  batchId        String    // agrupa os registos emitidos juntos num mesmo PDF/Excel
  employee       Employee  @relation(fields: [employeeId], references: [id])
  employeeId     String
  createdAt      DateTime  @default(now()) // momento real da emissão do formulário

  @@index([employeeId])
  @@index([dataOcorrencia])
  @@index([createdAt])
}

model HoraExtraRecord {
  id               String   @id @default(uuid())
  batchId          String   // agrupa os colaboradores da mesma folha gerada junto (mesmo PDF/Excel)
  dataServico      DateTime // Data do serviço realizado (campo "DATA" do cabeçalho)
  local            String   // Local do(s) serviço(s) realizado(s)
  descricaoServico String?
  enderecoServico  String?
  numeroOS         String?
  observacao       String?
  employee         Employee @relation(fields: [employeeId], references: [id])
  employeeId       String
  createdAt        DateTime @default(now()) // momento real da emissão do formulário

  @@index([employeeId])
  @@index([dataServico])
  @@index([batchId])
}

model Document {
  id         String   @id @default(uuid())
  docType    String   // Ex: ASO, NR 35
  issueDate  DateTime?
  expiryDate DateTime // Para calcular o prazo de vencimento
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([expiryDate])
}